# ============================================================
#  AVORA OTA Platform — .gitignore
#  Git root: AVORA/
# ============================================================

# ─── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Vite / Frontend Build ───────────────────────────────────
avora_project/frontend/dist/
avora_project/frontend/.vite/
avora_project/frontend/dist-ssr/
*.local

# ─── Backend Build ───────────────────────────────────────────
avora_project/backend/dist/
avora_project/backend/build/

# ─── OS & Editor ─────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs
.idea/
*.iml

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── Testing & Coverage ──────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Misc ────────────────────────────────────────────────────
*.tsbuildinfo
.cache/
.temp/
tmp/