# Supabase (dùng để upload ảnh đại diện thẳng lên Storage - bucket `pfp`)
# Lấy ở: Supabase Dashboard -> Project Settings -> API
# CHỈ dùng "anon public" key, KHÔNG dùng service_role key ở frontend.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

VITE_VIETMAP_TILE_KEY=your VietMap tile API key here
# (Tùy chọn) URL backend, mặc định http://localhost:5000
# VITE_API_BASE_URL=http://localhost:5000
